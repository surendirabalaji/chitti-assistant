# Chitti A3: configuration reference. PLACEHOLDERS ONLY. Never put real values in this file or in git.
#
# Nothing reads this file directly. The cloud agent gets these values from Cloud Run:
#   secrets   -> --update-secrets NAME=<secret-name>:latest   (Google Secret Manager)
#   variables -> --update-env-vars NAME=value
# The laptop side keeps its own values outside the repo (see "Laptop" below).

# ---- Secrets (Secret Manager -> container env; startup.sh moves them to 0600 files and unsets them) ----
TS_AUTHKEY=tskey-auth-REPLACE_ME            # secret "tailscale-authkey": reusable, non-ephemeral, tag:a3-agent
TELEGRAM_BOT_TOKEN=000000000:REPLACE_ME     # secret "telegram-bot-token" (BotFather)
GOG_KEYRING_PASSWORD=REPLACE_ME             # secret "gog-keyring-password": encrypts gog's token keyring on the bucket
GOG_OAUTH_CLIENT_JSON={"installed":{"client_id":"REPLACE_ME.apps.googleusercontent.com","client_secret":"REPLACE_ME"}}  # secret "gog-oauth-client" (Desktop OAuth client)

# ---- Plain environment variables (Cloud Run --update-env-vars) ----
GOG_ACCOUNT=test-account@example.com        # class-only throwaway Gmail/Calendar account
TELEGRAM_OWNER_ID=000000000                 # numeric Telegram user id of the owner (allowlist + exec approvals)

# ---- Set in deploy/Dockerfile (defaults; override only if your setup differs) ----
TS_HOSTNAME=a3-cloud-agent
STATE_MOUNT=/mnt/state                      # Cloud Storage bucket volume mount
OLLAMA_UPSTREAM=http://your-laptop.your-tailnet.ts.net:11434   # laptop Ollama via tailscale serve
FORWARDER_LISTEN=127.0.0.1:11435            # must be loopback
SOCKS_PROXY=socks5h://127.0.0.1:1055        # userspace tailscaled SOCKS5
OPENCLAW_STATE_DIR=/home/agent/.openclaw
GOG_HOME=/mnt/state/gogcli

# ---- Deploy-time values (gcloud flags, not env vars) ----
# GCP_PROJECT=your-project-id
# REGION=us-west1
# STATE_BUCKET=your-state-bucket            # --add-volume type=cloud-storage, mount-options uid=10001;gid=10001
# SERVICE_ACCOUNT=your-runtime-sa@your-project-id.iam.gserviceaccount.com   # no user-managed keys
# IMAGE=REGION-docker.pkg.dev/your-project-id/a3/agent:TAG

# ---- Laptop (not in the container) ----
# Ollama listens on 127.0.0.1:11434 only (never OLLAMA_HOST=0.0.0.0); exposed to the tailnet with:
#   tailscale serve --bg --tcp 11434 tcp://127.0.0.1:11434
# ChatGPT sign-in (cloud): browser login over instance SSH as user agent, see deploy/LOGIN.md.
