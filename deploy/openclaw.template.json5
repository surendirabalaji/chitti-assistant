// OpenClaw config for the Cloud Run container (CSCI 599 A3, chitti-assistant).
// Copied to $OPENCLAW_CONFIG_PATH by deploy/startup.sh on every boot; the `auth`
// block written by the ChatGPT login is carried over (see startup.sh).
// Keys verified against the installed OpenClaw 2026.10.9 schema + bundled docs (Nov 12).
// No secrets in this file: the gateway token comes from an env var set at boot.
{
  gateway: {
    mode: "local",                 // gateway refuses to start unless "local"
    port: 18789,
    bind: "loopback",              // 127.0.0.1 inside the container only
    auth: {
      mode: "token",
      // SecretRef: read from the env var at runtime, never written to disk.
      token: { source: "env", provider: "default", id: "OPENCLAW_GATEWAY_TOKEN" },
      allowTailscale: true,        // tailnet users identified by Tailscale Serve headers skip the token
    },
    tailscale: { mode: "serve" },  // OpenClaw runs `tailscale serve` (HTTPS :443 -> gateway)
    controlUi: {
      enabled: true,
      allowedOrigins: ["https://a3-cloud-agent.tail9bf1e8.ts.net"],
    },
    terminal: { enabled: false },  // no shell terminal in the dashboard
  },

  // Browser plugin is not in plugins.allow; also switch it and cookie import off explicitly.
  browser: { enabled: false, allowSystemProfileImport: false },

  // Telegram (M4): owner-only DMs, groups blocked. The bot token comes from Secret Manager via
  // startup.sh (0600 file, env var unset); the owner's numeric ID from the deploy-time env var
  // TELEGRAM_OWNER_ID (not a secret, kept out of the repo). Only one poller per bot token:
  // Telegram is disabled on the laptop (Nov 13).
  channels: {
    telegram: {
      enabled: true,
      tokenFile: "/home/agent/.config/a3/telegram-bot-token",
      dmPolicy: "allowlist",
      allowFrom: ["${TELEGRAM_OWNER_ID}"],
      groupPolicy: "allowlist",          // no groupAllowFrom -> no group can use the bot
      // Exec approvals (send-email, any allowlist miss) as a DM to the owner, with inline buttons.
      execApprovals: { enabled: true, target: "dm" },
      capabilities: { inlineButtons: "dm" },
    },
  },
  // send-email skill (tells the agent the only way to send mail); script installed at /usr/local/bin/send-email.
  skills: { load: { extraDirs: ["/app/skills"] } },
  // Owner for owner-only commands and exec approvals (approval buttons in Telegram).
  commands: { ownerAllowFrom: ["telegram:${TELEGRAM_OWNER_ID}"] },

  discovery: { mdns: { mode: "off" } },   // no Bonjour broadcasting in the cloud
  update: { checkOnStart: false },        // pinned version: no update checks or auto-apply

  agents: {
    defaults: {
      model: {
        primary: "openai/gpt-6-astra",    // no "@profile" suffix (A4 finding)
        fallbacks: [],                    // no automatic failover; the router decides
      },
      // Run ChatGPT on OpenClaw's own agent runtime (same as the laptop). Without this,
      // doctor reports the model wants the Codex runtime, whose plugin is not enabled.
      models: {
        "openai/gpt-6-astra": { agentRuntime: { id: "openclaw" } },
      },
      utilityModel: "ollama/gemma4-a3:e2b", // titles/narration stay local (they carry message text and bypass the router); fail when the laptop is off
      heartbeat: { every: "0m" },         // no recurring heartbeat turns; proactive jobs are explicit cron (M6)
    },
  },

  models: {
    providers: {
      ollama: {
        baseUrl: "http://127.0.0.1:11435", // the forwarder (M2 step 8) -> Tailscale SOCKS5 -> laptop
        apiKey: "ollama-local",            // marker value, not a secret (loopback provider)
        api: "ollama",
        timeoutSeconds: 300,
        models: [
          {
            id: "gemma4-a3:e2b",
            name: "gemma4-a3:e2b",
            input: ["text"],
            contextTokens: 32768,
            params: { num_ctx: 32768, think: false },
          },
        ],
      },
    },
  },

  plugins: {
    // Exclusive allowlist: everything else (browser, github, cua-computer, bonjour, ...) stays off.
    // web-readability: bundled, local-only main-text extraction for web_fetch on HTML pages.
    allow: ["a3-router", "openai", "ollama", "memory-core", "telegram", "parallel", "web-readability"],
    // parallel = @openclaw/parallel-plugin, pinned in deploy/package.json (key-free web search).
    load: { paths: ["/app/router", "/app/openclaw/node_modules/@openclaw/parallel-plugin"] },
    entries: {
      "a3-router": {
        enabled: true,
        hooks: { allowConversationAccess: true },   // required for before_model_resolve
        // Router v2: Gemma labels each message through the forwarder (loopback only).
        // logMirrorFile: metadata-only copy of the router lines on local disk, read by a3-activity (6 PM recap).
        config: { ollamaUrl: "http://127.0.0.1:11435", classifier: true, classifierTimeoutMs: 2000, healthCheck: true, simulateRateLimit: false, privateWhenLocalDown: "cloud", logMirrorFile: "/tmp/a3-router.log" },
      },
      "memory-core": {
        config: { dreaming: { enabled: false } },   // no background MEMORY.md rewrites
      },
    },
  },

  // Scheduled jobs (M6) are declared by deploy/jobs/install-jobs.sh at boot.
  cron: {
    // No replay of slots missed while the container was down (no 6 PM recap at 2 AM); install-jobs.sh
    // catches up the briefing (before noon) and recap (before 22:00) itself (docs cron-jobs/managing-jobs.md).
    skipMissedJobs: true,
    // Condition-trigger scripts, script payloads and stream jobs run unattended with the agent's full
    // tool policy including exec (docs cron-jobs/schedules.md warning). Not used here, so off.
    triggers: { enabled: false },
  },

  tools: {
    // allowlist + human approval on every miss. strictInlineEval: inline code (node -e, python -c, sed,
    // awk, find -exec, xargs, ...) always needs approval, even for an allowlisted binary, and never
    // becomes an allow-always rule (docs tools/exec.md "Inline eval"). Owner decision Nov 14.
    exec: { mode: "ask", strictInlineEval: true },
    web: { search: { provider: "parallel-free" } },   // must be explicit; weather uses web_fetch (core)
  },
}
